{
  "name": "Eurcontroller · Control de gastos",
  "short_name": "Eurcontroller",
  "description": "Registra gastos e ingresos, fija presupuestos mensuales y sigue tus objetivos de ahorro.",
  "lang": "es-ES",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f4f6fb",
  "theme_color": "#1d4ed8",
  "categories": ["finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/movil-panel.png",
      "sizes": "414x896",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Panel con los indicadores del mes"
    },
    {
      "src": "assets/screenshots/movil-movimientos.png",
      "sizes": "414x896",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Listado de movimientos"
    },
    {
      "src": "assets/screenshots/escritorio-panel.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Panel en escritorio"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuevo movimiento",
      "short_name": "Nuevo",
      "url": "./#/movimientos",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Presupuestos",
      "url": "./#/presupuestos",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ahorro",
      "url": "./#/ahorro",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
